{
  "name": "fabric-gateway-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Live Direct versus Postman Fabric Gateway agent orchestration showcase",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "json-canonicalize": "^1.2.0",
    "openai": "^5.23.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
